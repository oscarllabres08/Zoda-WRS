{
  "expo": {
    "name": "Aquabeast WRS Owner",
    "slug": "seller-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "../icon.jpeg",
    "scheme": "sellerapp",
    "userInterfaceStyle": "automatic",
    "androidStatusBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#E6F4FE",
      "translucent": false
    },
    "splash": {
      "image": "../icon.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#E6F4FE"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aquabeast.sellerapp"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "../icon.jpeg"
      },
      "package": "com.aquabeast.sellerapp",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "../icon.jpeg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "../notification.wav"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "82338448-d39f-4dc8-a07e-88a24d3afdd4"
      }
    }
  }
}
